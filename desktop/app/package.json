{
  "name": "atvloadly-desktop",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-locales": "mkdir -p locales && cp -R ../../locales/. locales/",
    "dev": "npm run sync-locales && cross-env CGO_ENABLED=0 mygo dev",
    "build": "cross-env CGO_ENABLED=0 mygo build",
    "build:release": "node build.mjs"
  },
  "devDependencies": {
    "cross-env": "^10.0.0",
    "mygo-cli": "^0.6.3"
  }
}
